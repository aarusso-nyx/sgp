{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "sgp-admin": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": "pt-BR",
        "locales": {
          "en-US": "src/locale/messages.en-US.xlf"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "polyfills": ["@angular/localize/init"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.2MB",
                  "maximumError": "1.25MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sgp-admin:build:production"
            },
            "development": {
              "buildTarget": "sgp-admin:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "vitest.admin.config.ts",
            "coverageInclude": [
              "src/app/features/folha-pagamento/**/*.ts",
              "src/app/features/recrutamento/**/*.ts",
              "src/app/features/fiscal/**/*.ts",
              "src/app/features/portal/lgpd-encarregado/**/*.ts",
              "src/app/features/portal-publico/concursos/inscricao/**/*.ts",
              "src/app/features/auditoria/**/*.ts",
              "src/app/core/audit/**/*.ts"
            ],
            "coverageReporters": ["text-summary", "json-summary", "lcov"],
            "coverageThresholds": {
              "statements": 90,
              "branches": 90,
              "functions": 90,
              "lines": 90
            }
          }
        },
        "extract-i18n": {
          "builder": "ng-extract-i18n-merge:ng-extract-i18n-merge",
          "options": {
            "buildTarget": "sgp-admin:build",
            "format": "xlf",
            "outputPath": "src/locale",
            "sourceFile": "messages.xlf",
            "targetFiles": ["messages.en-US.xlf"],
            "includeContext": "sourceFileOnly",
            "newTranslationTargetsBlank": false,
            "sort": "stableAlphabetNew"
          }
        }
      }
    },
    "sgp-portal": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "portal",
      "sourceRoot": "portal/src",
      "prefix": "portal",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "index": "portal/src/index.html",
            "browser": "portal/src/main.ts",
            "tsConfig": "tsconfig.portal.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["portal/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sgp-portal:build:production"
            },
            "development": {
              "buildTarget": "sgp-portal:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.portal.spec.json",
            "runnerConfig": "vitest.portal.config.ts",
            "coverageInclude": [
              "portal/src/app/pages/contracheque/**/*.ts",
              "portal/src/app/core/portal/portal-feature-catalog.ts",
              "portal/src/app/core/portal/portal-route-endpoints.ts"
            ],
            "coverageReporters": ["text-summary", "json-summary", "lcov"],
            "coverageThresholds": {
              "statements": 90,
              "branches": 90,
              "functions": 90,
              "lines": 90
            }
          }
        }
      }
    }
  }
}
