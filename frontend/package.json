{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve sgp-admin",
    "start:admin": "ng serve sgp-admin",
    "start:portal": "ng serve sgp-portal",
    "build": "ng build sgp-admin",
    "build:admin": "ng build sgp-admin",
    "build:portal": "ng build sgp-portal",
    "watch": "ng build sgp-admin --watch --configuration development",
    "watch:portal": "ng build sgp-portal --watch --configuration development",
    "test": "ng test sgp-admin --watch=false",
    "test:admin": "ng test sgp-admin --watch=false",
    "test:portal": "ng test sgp-portal --watch=false",
    "test:admin:coverage": "ng test sgp-admin --watch=false --coverage",
    "test:portal:coverage": "ng test sgp-portal --watch=false --coverage",
    "test:coverage": "npm run test:admin:coverage && npm run test:portal:coverage",
    "test:admin:e2e": "playwright test -c ../tests/playwright.admin.config.ts",
    "test:portal:e2e": "playwright test -c ../tests/playwright.portal.config.ts",
    "i18n:extract": "ng extract-i18n sgp-admin",
    "i18n:check": "node ../scripts/check-frontend.mjs i18n",
    "lint": "node ../scripts/check-frontend.mjs all",
    "lint:check": "node ../scripts/check-frontend.mjs all",
    "format": "prettier --write --ignore-unknown portal/src src angular.json package.json tsconfig.app.json tsconfig.json tsconfig.portal.app.json tsconfig.portal.spec.json tsconfig.spec.json",
    "format:check": "prettier --check --ignore-unknown portal/src src angular.json package.json tsconfig.app.json tsconfig.json tsconfig.portal.app.json tsconfig.portal.spec.json tsconfig.spec.json",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.portal.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.portal.spec.json"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/forms": "21.2.18",
    "@angular/localize": "21.2.18",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.18",
    "@angular/router": "21.2.18",
    "@stynx-nyx/angular": "^1.0.0",
    "@stynx-nyx/angular-auth": "^1.0.0",
    "@stynx-nyx/angular-i18n": "^1.0.0",
    "@stynx-nyx/angular-profile": "^1.0.0",
    "@stynx-nyx/angular-sessions": "^1.0.0",
    "@stynx-nyx/angular-storage": "^1.0.0",
    "@stynx-nyx/angular-tenancy": "^0.1.0",
    "@stynx-nyx/angular-trash": "^1.0.0",
    "@stynx-nyx/angular-ui": "^1.0.0",
    "@stynx-nyx/sdk": "^1.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.18",
    "@angular/cli": "21.2.18",
    "@angular/compiler-cli": "21.2.18",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^28.0.0",
    "ng-extract-i18n-merge": "^3.3.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
