            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "required": false,
            "in": "query",
            "schema": {
              "default": "asc",
              "type": "string",
              "enum": ["asc", "desc"]
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Case-insensitive text filter for representative read endpoints.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dateFrom",
            "required": false,
            "in": "query",
            "description": "Inclusive event start date/time.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dateTo",
            "required": false,
            "in": "query",
            "description": "Inclusive event end date.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actor",
            "required": false,
            "in": "query",
            "description": "Actor login or Cognito subject.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "CREATE",
                "READ",
                "UPDATE",
                "DELETE",
                "LOGIN",
                "LOGOUT",
                "IMPORT",
                "EXPORT",
                "GENERATE",
                "PROCESS",
                "APPROVE",
                "REJECT",
                "DOWNLOAD"
              ]
            }
          },
          {
            "name": "tableName",
            "required": false,
            "in": "query",
            "description": "Database table name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resourceType",
            "required": false,
            "in": "query",
            "description": "Domain resource type.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resourceId",
            "required": false,
            "in": "query",
            "description": "Domain resource identifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "requestId",
            "required": false,
            "in": "query",
            "description": "Request correlation id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "statusCode",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 100,
              "maximum": 599,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged audit events."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": ["audit"]
