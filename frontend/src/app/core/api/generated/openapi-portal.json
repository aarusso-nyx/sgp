  "info": {
    "title": "SGP Portal API",
    "description": "Read-only SGP portal API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "Object": {
        "type": "object",
        "properties": {}
      },
      "AuditReportRequestDto": {
        "type": "object",
        "properties": {
          "dateFrom": {
            "type": "string"
          },
          "dateTo": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "CREATE",
              "READ",
              "UPDATE",
              "DELETE",
              "LOGIN",
              "LOGOUT",
              "IMPORT",
              "EXPORT",
              "GENERATE",
              "PROCESS",
              "APPROVE",
              "REJECT",
              "DOWNLOAD"
            ]
          },
          "tableName": {
            "type": "string"
          },
          "resourceType": {
            "type": "string"
          },
          "search": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          }
        }
      },
      "CadastralChangeRequestDto": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "enum": ["cadastro", "endereco", "contato", "dependentes", "documentos"]
          },
          "payload": {
            "type": "object"
          },
          "previousPayload": {
            "type": "object"
          }
        },
        "required": ["section", "payload"]
      },
      "PayslipBatchRequestDto": {
        "type": "object",
        "properties": {}
      },
      "YearlyIncomeBatchRequestDto": {
        "type": "object",
        "properties": {}
      },
      "EvaluationCriteriaDto": {
        "type": "object",
        "properties": {
          "criterio": {
            "type": "string"
          },
          "nota": {
            "type": "number"
          },
          "observacao": {
            "type": "string"
          }
        },
        "required": ["criterio", "nota"]
      },
      "CreatePerformanceEvaluationDto": {
        "type": "object",
        "properties": {
          "funcionarioId": {
            "type": "string"
          },
          "periodo": {
            "type": "string"
          },
          "nota": {
            "type": "number"
          },
          "criterios": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvaluationCriteriaDto"
            }
          },
          "avaliadorId": {
            "type": "string"
          },
          "dataAvaliacao": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": ["RASCUNHO", "SUBMETIDA", "APROVADA", "REPROVADA"]
          },
          "observacao": {
            "type": "string"
          }
        },
        "required": [
          "funcionarioId",
          "periodo",
          "nota",
          "criterios",
          "avaliadorId",
          "dataAvaliacao"
        ]
      },
      "UpdatePerformanceEvaluationDto": {
        "type": "object",
        "properties": {
          "nota": {
            "type": "number"
          },
          "criterios": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvaluationCriteriaDto"
            }
          },
          "status": {
            "type": "string",
            "enum": ["RASCUNHO", "SUBMETIDA", "APROVADA", "REPROVADA"]
          },
          "dataAvaliacao": {
            "type": "string",
            "format": "date"
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "CreateMeritProgressionDto": {
        "type": "object",
        "properties": {
          "funcionarioId": {
            "type": "string"
          },
          "avaliacaoId": {
            "type": "string"
          },
          "referenciaOrigemId": {
            "type": "string"
          },
          "referenciaDestinoId": {
            "type": "string"
          },
          "dataVigencia": {
            "type": "string",
            "format": "date"
          },
          "atoNomeacao": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": ["MERITO", "TITULARIDADE", "JUDICIAL", "CORRECAO"],
            "default": "MERITO"
          },
          "justificativa": {
            "type": "string"
          },
          "aprovadoPorId": {
            "type": "string"
          }
        },
        "required": ["funcionarioId", "referenciaDestinoId", "dataVigencia", "tipo"]
      },
      "SalarySimulationAdjustmentDto": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          },
          "percentual": {
            "type": "string"
          },
          "valorFixo": {
            "type": "string"
          }
        },
        "required": ["descricao"]
      },
      "CreateSalarySimulationDto": {
        "type": "object",
        "properties": {
          "funcionarioId": {
            "type": "string"
          },
          "cenario": {
            "type": "string"
          },
          "ajustes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalarySimulationAdjustmentDto"
            }
          },
          "contexto": {
            "type": "object"
          }
        },
        "required": ["funcionarioId", "cenario"]
      },
      "CreateCareerPlanDto": {
        "type": "object",
        "properties": {
          "funcionarioId": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "versao": {
            "type": "string"
          },
          "dataVigencia": {
            "type": "string",
            "format": "date"
          },
          "niveis": {
            "type": "object"
          },
          "referencias": {
            "type": "object"
          },
          "ativo": {
            "type": "boolean",
            "default": true
          }
        },
        "required": ["nome", "versao", "dataVigencia"]
      },
      "UpdateCareerPlanDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "versao": {
            "type": "string"
          },
          "dataVigencia": {
            "type": "string",
            "format": "date"
          },
          "niveis": {
            "type": "object"
          },
          "referencias": {
            "type": "object"
          },
          "ativo": {
            "type": "boolean"
          }
        }
      },
      "GenerateAvaliacaoReportDto": {
        "type": "object",
        "properties": {
          "formato": {
            "type": "string",
            "example": "PDF"
          },
          "lotacaoId": {
            "type": "string"
          }
        }
      },
      "CareerPlanMutationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "institutingLaw": {
            "type": "string"
          },
          "startsOn": {
            "type": "string",
            "format": "date"
          },
          "endsOn": {
            "type": "string",
            "format": "date"
          },
          "classCount": {
            "type": "number"
          },
          "referenceCount": {
            "type": "number"
          },
          "progressionRule": {
            "type": "string"
          },
          "jobPositionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "salaryRangeId": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "institutingLaw",
          "startsOn",
          "classCount",
          "referenceCount",
          "progressionRule"
        ]
      },
      "CreateProbationEvaluationDto": {
        "type": "object",
        "properties": {
          "funcionarioId": {
            "type": "string"
          },
          "periodoInicio": {
            "type": "string",
            "format": "date"
          },
          "periodoFim": {
            "type": "string",
            "format": "date"
          },
          "nota": {
            "type": "number"
          },
          "decisao": {
            "type": "string",
            "enum": ["pending", "approved", "rejected", "extended"]
          },
          "avaliadorId": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        },
        "required": ["funcionarioId", "periodoInicio", "periodoFim", "nota", "decisao"]
      },
      "ProgressionSimulationDto": {
        "type": "object",
        "properties": {
          "employeeId": {
            "type": "string"
          },
          "effectDate": {
            "type": "string",
            "format": "date"
          },
          "progressionType": {
            "type": "string",
            "enum": ["merit_horizontal", "vertical_promotion"]
          },
          "targetSalaryRangeLevelId": {
            "type": "string"
          },
          "performanceEvaluationId": {
            "type": "string"
          },
          "administrativeProcessId": {
            "type": "string"
          },
          "earningDeductionId": {
            "type": "string"
          },
          "appointmentAct": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          }
        },
        "required": ["employeeId", "effectDate"]
      },
      "MassAdjustmentScopeDto": {
        "type": "object",
        "properties": {
          "careerPlanId": {
            "type": "string"
          },
          "salaryRangeId": {
            "type": "string"
          }
        }
      },
      "MassAdjustmentDto": {
        "type": "object",
        "properties": {
          "percentual": {
            "type": "string",
            "description": "Percent adjustment rate, for example 5.25 for 5.25%."
          },
          "vigenciaInicio": {
            "type": "string",
            "format": "date"
          },
          "leiReferencia": {
            "type": "string"
          },
          "motivo": {
            "type": "string",
            "enum": ["reajuste_data_base", "correcao", "reestruturacao"]
          },
          "escopo": {
            "$ref": "#/components/schemas/MassAdjustmentScopeDto"
          }
        },
        "required": ["percentual", "vigenciaInicio", "leiReferencia", "escopo"]
      }
    }
  }
}
