{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "semi": true,
  "overrides": [
    {
      "files": ["backend/**/*.ts", "tests/backend/**/*.ts"],
      "options": {
        "printWidth": 80
      }
    },
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    }
  ]
}
