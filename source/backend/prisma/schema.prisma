generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "hr", "payroll", "portal"]
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("public")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@schema("public")
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  IMPORT
  EXPORT
  GENERATE
  PROCESS
  APPROVE
  REJECT
  DOWNLOAD

  @@schema("public")
}

enum BranchType {
  HEADQUARTERS
  BRANCH
  DEPARTMENT
  EXTERNAL

  @@schema("public")
}

enum PersonGender {
  FEMALE
  MALE
  OTHER
  UNDECLARED

  @@schema("public")
}

enum EmployeeLifecycleStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RETIRED
  INTERN

  @@schema("public")
}

enum PayrollRunStatus {
  DRAFT
  QUEUED
  PROCESSING
  GENERATED
  APPROVED
  PAID
  CANCELED
  FAILED
  CLOSED

  @@schema("public")
}

enum PayrollEntryKind {
  EARNING
  DEDUCTION
  INFORMATION
  BASE

  @@schema("public")
}

enum PayrollEntrySource {
  MANUAL
  IMPORTED
  CALCULATED
  ADJUSTMENT

  @@schema("public")
}

enum PaymentRemittanceStatus {
  DRAFT
  GENERATED
  SENT
  PAID
  REJECTED
  CANCELED

  @@schema("public")
}

enum AdvanceRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
  CANCELED

  @@schema("public")
}

enum AdvancePaymentStatus {
  PENDING
  GENERATED
  PAID
  CANCELED

  @@schema("public")
}

enum ReportRequestStatus {
  REQUESTED
  RUNNING
  COMPLETED
  FAILED
  EXPIRED

  @@schema("public")
}

enum DocumentStorageKind {
  LOCAL
  S3
  EXTERNAL

  @@schema("public")
}

enum DocumentUploadStatus {
  PENDING
  REGISTERED
  EXPIRED
  ABORTED

  @@schema("public")
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED

  @@schema("public")
}

enum RecruitmentRequestStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELED

  @@schema("public")
}

enum RecruitmentCandidateStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}

enum RecruitmentHiringType {
  EFFECTIVE
  COMMISSIONED
  CONTRACTOR
  INTERN

  @@schema("public")
}

enum MedicalAppointmentStatus {
  SCHEDULED
  ATTENDED
  NO_SHOW
  CANCELED

  @@schema("public")
}

enum MedicalReportStatus {
  PENDING_SUBMISSION
  APPROVED
  REJECTED

  @@schema("public")
}

enum ESocialEventStatus {
  PENDENTE
  GERANDO_XML
  ASSINANDO
  ENVIANDO
  AGUARDANDO_RETORNO
  PROCESSADO_COM_SUCESSO
  PROCESSADO_COM_ERROS
  ERRO_TECNICO_RETENTAVEL
  ERRO_DEFINITIVO
  EXCLUIDO

  @@schema("public")
}

enum PerformanceEvaluationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED

  @@schema("public")
}

enum ProgressionKind {
  MERIT
  TITLE
  JUDICIAL
  CORRECTION

  @@schema("public")
}

enum PensionCompensationStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED
  SETTLED

  @@schema("public")
}

enum RecertificationBeneficiaryType {
  RETIREE
  PENSIONER
  UNIVERSITY_PENSIONER

  @@schema("public")
}

enum RecertificationStatus {
  PENDING
  RECERTIFIED
  NEAR_DUE
  OVERDUE
  BLOCKED

  @@schema("public")
}

enum ExternalLifeProofChannel {
  PORTAL_COLABORADOR
  PREFEITURA_PUBLICA
  GOV_BR

  @@schema("public")
}

model Tenant {
  id        String       @id @db.Uuid
  slug      String       @unique
  code      String       @unique
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("tenant")
  @@schema("public")
}

model UserAccount {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  cognitoSub        String?    @map("cognito_sub")
  login             String
  cpf               String?
  name              String
  email             String?
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  metadata          Json       @default("{}")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt     DateTime?  @map("deactivated_at") @db.Timestamptz(6)

  profileAssignments      ProfileAssignment[]
  groupSnapshots          UserGroupSnapshot[]
  auditEvents             AuditEvent[]              @relation("AuditActor")
  reportRequests          ReportRequest[]           @relation("ReportRequestedBy")
  downloads               DocumentDownloadAudit[]
  payrollRuns             PayrollRun[]              @relation("PayrollCreatedBy")
  remittanceFiles         PaymentRemittanceFile[]   @relation("RemittanceCreatedBy")
  payrollRunStatusChanges PayrollRunStatusHistory[] @relation("PayrollRunStatusChangedBy")
  systemParameterUpdates  SystemParameter[]         @relation("SystemParameterUpdatedBy")
  notifications           Notification[]            @relation("NotificationUser")

  @@unique([tenantId, cognitoSub])
  @@unique([tenantId, login])
  @@unique([tenantId, cpf])
  @@unique([tenantId, email])
  @@index([status])
  @@index([tenantId, status])
  @@map("user_account")
  @@schema("public")
}

model AccessProfile {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String       @default("")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments ProfileAssignment[]
  permissions ProfilePermission[]
  menuItems   MenuItem[]

  @@unique([tenantId, code])
  @@index([status])
  @@map("access_profile")
  @@schema("public")
}

model ProfileAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  profileId String    @map("profile_id") @db.Uuid
  startsAt  DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    UserAccount   @relation(fields: [userId], references: [id])
  profile AccessProfile @relation(fields: [profileId], references: [id])

  @@unique([userId, profileId, startsAt])
  @@index([profileId])
  @@index([endsAt])
  @@map("profile_assignment")
  @@schema("public")
}

model Permission {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  moduleKey    String   @map("module_key")
  resourceKey  String   @map("resource_key")
  actionKey    String   @map("action_key")
  description  String   @default("")
  routePattern String?  @map("route_pattern")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profiles ProfilePermission[]

  @@unique([moduleKey, resourceKey, actionKey])
  @@index([moduleKey])
  @@index([resourceKey])
  @@map("permission")
  @@schema("public")
}

model ProfilePermission {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  allowed      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile    AccessProfile @relation(fields: [profileId], references: [id])
  permission Permission    @relation(fields: [permissionId], references: [id])

  @@unique([profileId, permissionId])
  @@index([permissionId])
  @@map("profile_permission")
  @@schema("public")
}

model UserGroupSnapshot {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  provider   String    @default("cognito")
  groupKey   String    @map("group_key")
  capturedAt DateTime  @default(now()) @map("captured_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  rawClaims  Json      @default("{}") @map("raw_claims")

  user UserAccount @relation(fields: [userId], references: [id])

  @@index([userId, capturedAt])
  @@index([groupKey])
  @@map("user_group_snapshot")
  @@schema("public")
}

model MenuItem {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  parentId  String?      @map("parent_id") @db.Uuid
  profileId String?      @map("profile_id") @db.Uuid
  code      String
  label     String
  route     String?
  moduleKey String       @map("module_key")
  sortOrder Int          @default(0) @map("sort_order")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   MenuItem?      @relation("MenuHierarchy", fields: [parentId], references: [id])
  children MenuItem[]     @relation("MenuHierarchy")
  profile  AccessProfile? @relation(fields: [profileId], references: [id])

  @@unique([tenantId, code])
  @@index([parentId])
  @@index([moduleKey, status])
  @@index([profileId])
  @@map("menu_item")
  @@schema("public")
}

model AuditEvent {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  occurredAt   DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  actorSub     String?     @map("actor_sub")
  actorLogin   String?     @map("actor_login")
  action       AuditAction
  resourceType String      @map("resource_type")
  resourceId   String?     @map("resource_id")
  tableName    String?     @map("table_name")
  requestId    String?     @map("request_id")
  ipAddress    String?     @map("ip_address") @db.Inet
  userAgent    String?     @map("user_agent")
  reason       String?
  metadata     Json        @default("{}")

  actor UserAccount? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([actorLogin])
  @@index([resourceType, resourceId])
  @@index([requestId])
  @@map("audit_event")
  @@schema("public")
}

model Company {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  code          String
  legalName     String       @map("legal_name")
  tradeName     String?      @map("trade_name")
  cnpj          String?
  legalNatureId String?      @map("legal_nature_id") @db.Uuid
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  legalNature LegalNature? @relation(fields: [legalNatureId], references: [id])
  branches    Branch[]

  @@unique([tenantId, code])
  @@unique([tenantId, cnpj])
  @@index([status])
  @@index([legalNatureId])
  @@map("company")
  @@schema("hr")
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  companyId  String       @map("company_id") @db.Uuid
  code       String
  acronym    String?
  name       String
  cnpj       String?
  branchType BranchType   @default(BRANCH) @map("branch_type")
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company                Company                         @relation(fields: [companyId], references: [id])
  employees              Employee[]
  workLocations          WorkLocation[]
  costCenters            CostCenter[]
  legalResponsibles      LegalResponsible[]
  payrollRuns            PayrollRun[]
  remittanceFiles        PaymentRemittanceFile[]
  financialRecords       PayrollFinancialRecord[]
  blockedPayments        BlockedPayment[]
  accountingAccounts     PayrollAccountingAccount[]
  fromTransfers          EmployeeTransfer[]              @relation("TransferFromBranch")
  toTransfers            EmployeeTransfer[]              @relation("TransferToBranch")
  exerciseRecords        EmployeeExercise[]              @relation("ExerciseBranch")
  processFunctions       AdministrativeProcessFunction[] @relation("ProcessFunctionBranch")
  reports                ReportRequest[]
  recruitmentRequests    RecruitmentRequest[]
  performanceEvaluations PerformanceEvaluation[]

  @@unique([tenantId, code])
  @@unique([tenantId, cnpj])
  @@index([companyId])
  @@index([status])
  @@map("branch")
  @@schema("hr")
}

model WorkLocation {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  branchId    String?      @map("branch_id") @db.Uuid
  parentId    String?      @map("parent_id") @db.Uuid
  code        String
  name        String
  description String       @default("")
  fpasCode    String       @default("000") @map("fpas_code")
  fapRate     Decimal      @default(0) @map("fap_rate") @db.Decimal(18, 6)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch                 Branch?                                @relation(fields: [branchId], references: [id])
  parent                 WorkLocation?                          @relation("WorkLocationHierarchy", fields: [parentId], references: [id])
  children               WorkLocation[]                         @relation("WorkLocationHierarchy")
  employees              Employee[]
  transfers              EmployeeTransfer[]
  exerciseRecords        EmployeeExercise[]
  processFunctions       AdministrativeProcessFunction[]
  financialRecords       PayrollFinancialRecord[]
  payrollRunRollups      PayrollRunWorkLocation[]
  accountingAccountLinks PayrollAccountingAccountWorkLocation[]
  recruitmentRequests    RecruitmentRequest[]
  performanceEvaluations PerformanceEvaluation[]
  structureAssignments   WorkLocationStructureAssignment[]

  @@unique([tenantId, code])
  @@index([branchId])
  @@index([parentId])
  @@index([status])
  @@map("work_location")
  @@schema("hr")
}

model CostCenter {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  branchId  String?      @map("branch_id") @db.Uuid
  code      String
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch             Branch?                    @relation(fields: [branchId], references: [id])
  employees          Employee[]
  accountingAccounts PayrollAccountingAccount[]

  @@unique([tenantId, code])
  @@index([branchId])
  @@index([status])
  @@map("cost_center")
  @@schema("hr")
}

model LegalResponsible {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  branchId  String       @map("branch_id") @db.Uuid
  name      String
  cpf       String?
  roleTitle String       @map("role_title")
  startsOn  DateTime     @map("starts_on") @db.Date
  endsOn    DateTime?    @map("ends_on") @db.Date
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, status])
  @@index([cpf])
  @@map("legal_responsible")
  @@schema("hr")
}

model JobPosition {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  code            String
  name            String
  description     String       @default("")
  vacanciesTotal  Int          @default(0) @map("vacancies_total")
  vacanciesFilled Int          @default(0) @map("vacancies_filled")
  vacanciesOpen   Int          @default(0) @map("vacancies_open")
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees               Employee[]
  earningLinks            JobPositionEarning[]
  performanceEvaluations  PerformanceEvaluation[]
  referenceLinks          JobStructureReferenceLink[]
  employmentLinks         JobStructureEmploymentLink[]
  workLocationAssignments WorkLocationStructureAssignment[]

  @@unique([tenantId, code])
  @@index([status])
  @@map("job_position")
  @@schema("hr")
}

model JobFunction {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String       @default("")
  natureId    String?      @map("nature_id") @db.Uuid
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  nature                  FunctionNature?                   @relation(fields: [natureId], references: [id])
  employees               Employee[]
  exerciseRecords         EmployeeExercise[]
  processFunctions        AdministrativeProcessFunction[]
  requisitionFunctions    RecruitmentRequestFunction[]
  performanceEvaluations  PerformanceEvaluation[]
  referenceLinks          JobStructureReferenceLink[]
  employmentLinks         JobStructureEmploymentLink[]
  workLocationAssignments WorkLocationStructureAssignment[]
  functionEarningLinks    JobFunctionEarning[]

  @@unique([tenantId, code])
  @@index([natureId])
  @@index([status])
  @@map("job_function")
  @@schema("hr")
}

model FunctionNature {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  code      String
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  functions JobFunction[]

  @@unique([tenantId, code])
  @@index([status])
  @@map("function_nature")
  @@schema("hr")
}

model SalaryRange {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  code      String
  groupCode String?      @map("group_code")
  classCode String?      @map("class_code")
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  references SalaryReference[]
  levels     SalaryRangeLevel[]

  @@unique([tenantId, code])
  @@index([groupCode, classCode])
  @@index([status])
  @@map("salary_range")
  @@schema("hr")
}

model SalaryReference {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  rangeId     String?      @map("range_id") @db.Uuid
  code        String
  description String
  amount      Decimal      @default(0) @db.Decimal(14, 2)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  range                   SalaryRange?         @relation(fields: [rangeId], references: [id])
  employees               Employee[]
  salaryLevels            SalaryLevelHistory[]
  rangeLevels             SalaryRangeLevel[]
  sourceMeritProgressions MeritProgression[]   @relation("MeritProgressionSourceSalaryReference")
  targetMeritProgressions MeritProgression[]   @relation("MeritProgressionTargetSalaryReference")

  @@unique([tenantId, code])
  @@index([rangeId])
  @@index([status])
  @@map("salary_reference")
  @@schema("hr")
}

model FunctionalStatus {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  code            String
  description     String
  modality        String?
  kind            String?
  entersPayroll   Boolean                 @default(false) @map("enters_payroll")
  lifecycleStatus EmployeeLifecycleStatus @default(ACTIVE) @map("lifecycle_status")
  status          RecordStatus            @default(ACTIVE)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees        Employee[]
  statusHistory    EmployeeStatusHistory[]
  financialRecords PayrollFinancialRecord[]
  blockedPayments  BlockedPayment[]

  @@unique([tenantId, code])
  @@index([entersPayroll])
  @@index([status])
  @@map("functional_status")
  @@schema("hr")
}

model EmploymentLink {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  code                 String
  name                 String
  contractType         String       @default("statutory") @map("contract_type")
  endDate              DateTime?    @map("end_date") @db.Date
  commissionPositionId String?      @map("commission_position_id") @db.Uuid
  regimeLawReference   String       @default("Lei 8.112/90") @map("regime_law_reference")
  functionalStatusId   String?      @map("functional_status_id") @db.Uuid
  status               RecordStatus @default(ACTIVE)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees       Employee[]
  contracts       EmploymentContract[]
  processingTypes ProcessingType[]
  earningLinks    EmploymentLinkEarning[]
  structureLinks  JobStructureEmploymentLink[]

  @@unique([tenantId, code])
  @@index([contractType])
  @@index([commissionPositionId])
  @@index([functionalStatusId])
  @@index([status])
  @@map("employment_link")
  @@schema("hr")
}

model ContractType {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  code      String
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees Employee[]
  contracts EmploymentContract[]

  @@unique([tenantId, code])
  @@index([status])
  @@map("contract_type")
  @@schema("hr")
}

model PayrollType {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  code        String
  description String
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
