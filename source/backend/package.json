{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --entryFile main",
    "start:dev": "nest start --watch --entryFile main",
    "start:debug": "nest start --debug --watch --entryFile main",
    "start:prod": "node dist/main",
    "start:portal": "nest start --entryFile main-portal",
    "start:portal:dev": "nest start --watch --entryFile main-portal",
    "start:portal:prod": "node dist/main-portal",
    "start:payroll-engine": "nest start --entryFile main-payroll-engine",
    "start:payroll-engine:dev": "nest start --watch --entryFile main-payroll-engine",
    "start:payroll-engine:prod": "node dist/main-payroll-engine",
    "start:esocial-worker": "nest start --entryFile main-esocial-worker",
    "start:esocial-worker:dev": "nest start --watch --entryFile main-esocial-worker",
    "start:esocial-worker:prod": "node dist/main-esocial-worker",
    "start:integrations-worker": "nest start --entryFile main-integrations-worker",
    "start:integrations-worker:dev": "nest start --watch --entryFile main-integrations-worker",
    "start:integrations-worker:prod": "node dist/main-integrations-worker",
    "start:report-service": "nest start --entryFile main-report-service",
    "start:report-service:dev": "nest start --watch --entryFile main-report-service",
    "start:report-service:prod": "node dist/main-report-service",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --rootDir . --testRegex \"(src/.*\\\\.spec\\\\.ts|test/.*\\\\.e2e-spec\\\\.ts)$\" --setupFiles \"<rootDir>/test/test-env.ts\" --collectCoverageFrom \"src/**/*.ts\" --collectCoverageFrom \"!src/**/*.spec.ts\" --collectCoverageFrom \"!src/main*.ts\" --collectCoverageFrom \"!src/**/*.controller.ts\" --collectCoverageFrom \"!src/**/*.dto.ts\" --collectCoverageFrom \"!src/**/*.module.ts\" --collectCoverageFrom \"!src/config/environment.ts\" --collectCoverageFrom \"!src/common/pagination/paged-response.ts\" --collectCoverageFrom \"!src/common/errors/standard-exception.filter.ts\" --coverageDirectory coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.3.0",
    "@prisma/client": "^7.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.1.0",
    "jwks-rsa": "^4.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!main*.ts",
      "!**/*.controller.ts",
      "!**/*.dto.ts",
      "!**/*.module.ts",
      "!config/environment.ts",
      "!common/pagination/paged-response.ts",
      "!common/errors/standard-exception.filter.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "lines": 85,
        "branches": 85,
        "functions": 85
      }
    },
    "coverageReporters": [
      "lcov",
      "text-summary",
      "cobertura"
    ],
    "testEnvironment": "node"
  }
}
