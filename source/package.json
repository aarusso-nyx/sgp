{
  "name": "sgp-modernization-source",
  "version": "0.1.0",
  "private": true,
  "description": "Modern SGP full-stack workspace: Angular, NestJS, PostgreSQL, Cognito.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "node scripts/run.mjs build",
    "build:workspaces": "npm run build:admin && npm run build:portal && npm run build:backend",
    "build:admin": "npm --workspace frontend run build:admin",
    "build:portal": "npm --workspace frontend run build:portal",
    "build:frontend": "npm run build:admin",
    "build:backend": "npm --workspace backend run build",
    "start:dev": "node scripts/run.mjs start",
    "start:admin": "npm --workspace frontend run start:admin -- --host 127.0.0.1 --port 4200",
    "start:portal": "npm --workspace frontend run start:portal -- --host 127.0.0.1 --port 4300",
    "start:frontend": "npm run start:admin",
    "start:backend": "npm --workspace backend run start:dev",
    "start:core-api": "APP_SERVICE_NAME=sgp-core-api npm --workspace backend run start:dev",
    "start:portal-api": "APP_SERVICE_NAME=sgp-portal-api npm --workspace backend run start:portal:dev",
    "start:payroll-engine": "APP_SERVICE_NAME=sgp-payroll-engine PAYROLL_ENGINE_PORT=3302 npm --workspace backend run start:payroll-engine",
    "start:esocial-worker": "APP_SERVICE_NAME=sgp-esocial-worker npm --workspace backend run start:esocial-worker",
    "start:integrations-worker": "APP_SERVICE_NAME=sgp-integrations-worker npm --workspace backend run start:integrations-worker",
    "start:report-service": "APP_SERVICE_NAME=sgp-report-service REPORT_SERVICE_PORT=3305 npm --workspace backend run start:report-service",
    "lint": "node scripts/run.mjs lint",
    "lint:workspaces": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm --workspace frontend run lint --if-present",
    "lint:backend": "npm --workspace backend run lint",
    "format": "node scripts/run.mjs format",
    "format:workspaces": "npm run format:frontend && npm run format:backend && npm run format:workspace",
    "format:frontend": "npm --workspace frontend exec -- prettier --write .",
    "format:backend": "npm --workspace backend run format",
    "format:workspace": "npx prettier --write docs database tests scripts infra package.json .gitignore",
    "test": "node scripts/run.mjs test",
    "test:workspaces": "npm run test:frontend && npm run test:portal && npm run test:backend",
    "test:frontend": "npm --workspace frontend run test:admin",
    "test:portal": "npm --workspace frontend run test:portal",
    "test:backend": "npm --workspace backend run test",
    "test:e2e": "npm --workspace backend run test:e2e",
    "test:coverage": "npm --workspace backend run test:cov",
    "test:qa": "npm run test:qa:api && npm run test:qa:frontend",
    "test:qa:api": "node --test tests/backend/api/*.test.mjs tests/backend/e2e/*.test.mjs",
    "test:qa:frontend": "node --test tests/frontend/e2e/*.test.mjs",
    "qa:bootstrap": "node scripts/qa-bootstrap.mjs",
    "qa:smoke:urls": "node scripts/qa-smoke-required-urls.mjs",
    "db": "node scripts/run.mjs db",
    "db:help": "node scripts/run.mjs db help",
    "db:generate": "npm --workspace backend exec -- prisma generate",
    "db:migrate": "npm --workspace backend exec -- prisma migrate dev",
    "db:seed": "npm --workspace backend run db:seed",
    "db:smoke": "node scripts/db-bootstrap-smoke.mjs",
    "db:studio": "npm --workspace backend exec -- prisma studio",
    "runtime:topology": "cat runtime/topology.json",
    "api:alignment:sync": "node scripts/sync-api-route-alignment.mjs",
    "api:alignment:check": "node scripts/check-api-route-alignment.mjs",
    "api:client:generate": "npm run build:backend && node scripts/generate-openapi-client.mjs",
    "db:alignment:check": "node scripts/check-db-alignment.mjs",
    "evidence:check": "node scripts/evidence-check.mjs",
    "commit:check": "npm run evidence:check",
    "deploy": "node scripts/run.mjs deploy",
    "deploy:plan": "node scripts/run.mjs deploy --dry-run",
    "deploy:stage": "node scripts/run.mjs deploy --target stage --stack all --dry-run",
    "deploy:prod": "node scripts/run.mjs deploy --target prod --stack all --dry-run",
    "health": "node scripts/run.mjs health",
    "health:json": "node scripts/run.mjs health --json"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module"
}
