# ================================
# Reverse-documentation runtime
# ================================
APP_BASE_URL=http://localhost:8080
APP_LOGIN=${APP_LOGIN}
APP_PASSWORD=${APP_PASSWORD}

# ================================
# Auth / Cognito
# ================================
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=example-client-id
COGNITO_DOMAIN=https://example.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:4200/auth/callback
COGNITO_LOGOUT_URI=http://localhost:4200/

# ================================
# API / database
# ================================
API_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://sgp:sgp@localhost:5432/sgp
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_DOCUMENTS_BUCKET=sgp-documents-stage
S3_DOCUMENTS_PRESIGN_EXPIRES_SECONDS=900
S3_DOCUMENTS_DOWNLOAD_EXPIRES_SECONDS=300
S3_DOCUMENTS_KEY_PREFIX=documents
MINIO_TEST_STORAGE_ENABLED=false
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_DOCUMENTS_BUCKET=sgp-test-documents
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ================================
# Deploy planning
# ================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
AWS_PROFILE=default
DEPLOY_TARGET=stage
BACKEND_IMAGE_URI=000000000000.dkr.ecr.us-east-1.amazonaws.com/sgp-backend:latest
FRONTEND_DOMAIN=sgp.example.com
COGNITO_CALLBACK_URL=https://sgp.example.com/auth/callback
COGNITO_LOGOUT_URL=https://sgp.example.com/
