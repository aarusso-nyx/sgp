  "profilePermissions": {
    "ADMIN": ["*"],
    "RH_OPERADOR": ["auth.read", "gestao.read", "gestao.master_data.read", "gestao.master_data.write", "rh.read", "rh.write", "rh.employee.read", "rh.employee.write", "rh.employee.admit", "rh.employee.terminate", "relatorio.generate"],
