    { "key": "documents.download", "moduleKey": "documents", "resourceKey": "attachment", "actionKey": "download", "routePattern": "#!/documentos/**", "description": "Download document attachments." },
    { "key": "auditoria.read", "moduleKey": "auditoria", "resourceKey": "audit", "actionKey": "read", "routePattern": "#!/auditoria/**", "description": "Read audit trail and audit report exports." }
