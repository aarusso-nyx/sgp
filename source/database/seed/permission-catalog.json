  "profiles": [
    {
      "code": "ADMIN",
      "name": "Administrador",
      "description": "Full local/test access profile for SGP modernization."
    },
    {
      "code": "RH_OPERADOR",
      "name": "Operador RH",
      "description": "Employee lifecycle maintenance and read-only supporting master data."
    },
    {
      "code": "FOLHA_OPERADOR",
      "name": "Operador Folha",
      "description": "Payroll generation, remittance, and payroll reports."
    },
    {
      "code": "AUDITOR",
      "name": "Auditor",
      "description": "Audit and report consultation."
    }
  ],
