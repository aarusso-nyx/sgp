    { "key": "convenio.write", "moduleKey": "convenio", "resourceKey": "agreement", "actionKey": "write", "routePattern": "#!/convenios/**", "description": "Mutate convenio records." },
    { "key": "relatorio.read", "moduleKey": "relatorio", "resourceKey": "report", "actionKey": "read", "routePattern": "#!/relatorio/**", "description": "Read report catalog and generated report status." },
