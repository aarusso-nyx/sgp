{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actions Inventory",
  "type": "object",
  "required": ["meta", "actions"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "updatedAt", "source"],
      "properties": {
        "version": { "type": "string" },
        "updatedAt": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "type", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string" },
          "route": { "type": "string" },
          "module": { "type": "string" },
          "result": { "type": "string" },
          "status": { "enum": ["observed", "inferred", "unverified"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
