{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Screens Inventory",
  "type": "object",
  "required": ["meta", "screens"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "updatedAt", "source"],
      "properties": {
        "version": { "type": "string" },
        "updatedAt": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "route", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "route": { "type": "string" },
          "module": { "type": "string" },
          "elements": {
            "type": "object",
            "properties": {
              "forms": { "type": "array", "items": { "type": "string" } },
              "tables": { "type": "array", "items": { "type": "string" } },
              "filters": { "type": "array", "items": { "type": "string" } },
              "dialogs": { "type": "array", "items": { "type": "string" } }
            }
          },
          "status": { "enum": ["observed", "inferred", "unverified"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
