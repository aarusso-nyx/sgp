{
  "schemaVersion": 1,
  "project": "sgp",
  "version": "0.0.1",
  "sourceRoot": ".",
  "authority": {
    "productAndEngineering": "docs/eng",
    "payrollEngine": "folia-first",
    "legacySchemaReference": "docs/leg/sql-reference",
    "reverseEvidenceArchive": "docs/leg/rev-eng"
  },
  "authoritativeDocs": [
    "docs/eng/README.md",
    "docs/eng/product.md",
    "docs/eng/platform.md",
    "docs/eng/experience.md",
    "docs/eng/quality-migration.md",
    "docs/eng/domains/payroll-benefits.md",
    "docs/eng/domains/fiscal-integrations.md",
    "docs/eng/domains/time-attendance-sst.md",
    "docs/eng/domains/privacy-transparency.md"
  ],
  "generatedSurfaces": [
    "docs/gov/generated/api/route-alignment.json",
    "docs/gov/generated/database/alignment-matrix.json",
    "docs/gov/generated/runtime-topology.json",
    "docs/gov/generated/governance-manifest.json"
  ],
  "hardFailGates": [
    {
      "id": "lint-check",
      "command": "npm run lint:check"
    },
    {
      "id": "format-check",
      "command": "npm run format:check"
    },
    {
      "id": "typecheck",
      "command": "npm run typecheck"
    },
    {
      "id": "type-contracts",
      "command": "npm run test:types"
    },
    {
      "id": "mutation",
      "command": "npm run test:mutation"
    },
    {
      "id": "duplication",
      "command": "npm run check:duplication"
    },
    {
      "id": "api-alignment",
      "command": "npm run api:alignment:check -- --json"
    },
    {
      "id": "db-alignment",
      "command": "npm run db:alignment:check -- --json"
    },
    {
      "id": "health-json",
      "command": "npm run health:json"
    },
    {
      "id": "governance-check",
      "command": "npm run governance:check"
    }
  ],
  "deferredOwnerDecisions": [
    "docs/work/prompts/admin-identity-install.prompt.md",
    "docs/work/prompts/esocial-transmission.prompt.md",
    "docs/work/prompts/infra-strategy.prompt.md",
    "docs/work/prompts/governance-release-gates.prompt.md"
  ]
}
