{
  "minTokens": 50,
  "threshold": 3,
  "format": ["typescript"],
  "pattern": "**/*.ts",
  "ignorePattern": ["import[\\s\\S]*?;"],
  "reporters": ["console"],
  "ignore": [
    "**/*.spec.ts",
    "**/*.e2e-spec.ts",
    "**/dist/**",
    "**/coverage/**",
    "**/.stryker-tmp/**",
    "frontend/src/app/core/api/generated/**",
    "frontend/portal/src/app/core/api/generated/**"
  ],
  "path": ["backend/src", "frontend/src", "frontend/portal/src"]
}
