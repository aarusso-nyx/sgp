{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/home/ec2-user/.pm2/logs/*.log",
            "log_group_name": "/sgp/{env}/pm2",
            "log_stream_name": "{instance_id}/{file_name}",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/sgp/*.log",
            "log_group_name": "/sgp/{env}/host",
            "log_stream_name": "{instance_id}/{file_name}",
            "timezone": "UTC"
          }
        ]
      }
    }
  },
  "metrics": {
    "append_dimensions": {
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}",
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["*"]
      },
      "mem": {
        "measurement": ["mem_used_percent"]
      }
    }
  }
}
