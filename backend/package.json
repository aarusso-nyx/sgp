{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "node ../scripts/generate.mjs permissions",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"../tests/backend/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"../tests/backend/**/*.ts\"",
    "start": "nest start --entryFile main",
    "start:dev": "nest start --watch --entryFile main",
    "start:debug": "nest start --debug --watch --entryFile main",
    "start:prod": "node dist/main",
    "start:portal": "nest start --entryFile main-portal",
    "start:portal:dev": "nest start --watch --entryFile main-portal",
    "start:portal:prod": "node dist/main-portal",
    "start:payroll-engine": "nest start --entryFile main-payroll-engine",
    "start:payroll-engine:dev": "nest start --watch --entryFile main-payroll-engine",
    "start:payroll-engine:prod": "node dist/main-payroll-engine",
    "start:integrations-worker": "nest start --entryFile main-integrations-worker",
    "start:integrations-worker:dev": "nest start --watch --entryFile main-integrations-worker",
    "start:integrations-worker:prod": "node dist/main-integrations-worker",
    "start:report-worker": "nest start --entryFile main-report-worker",
    "start:report-worker:dev": "nest start --watch --entryFile main-report-worker",
    "start:report-worker:prod": "node dist/main-report-worker",
    "start:report-service": "nest start --entryFile main-report-service",
    "start:report-service:dev": "nest start --watch --entryFile main-report-service",
    "start:report-service:prod": "node dist/main-report-service",
    "lint": "eslint \"src/**/*.ts\" \"../tests/backend/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\" \"../tests/backend/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest --config ../tests/backend/jest-unit.json",
    "test:watch": "jest --config ../tests/backend/jest-unit.json --watch",
    "test:cov": "jest --config ../tests/backend/jest-coverage.json",
    "test:exception-filter": "jest --config ../tests/backend/jest-exception-filter-coverage.json",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ../tests/backend/jest-unit.json --runInBand",
    "test:e2e": "jest --config ../tests/backend/jest-e2e.json",
    "db:seed": "node ../database/seed/run.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/client-sqs": "^3.1042.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@stynx-nyx/auth": "^1.0.0",
    "@stynx-nyx/backend": "^1.0.0",
    "@stynx-nyx/contracts": "^1.0.0",
    "@stynx-nyx/core": "^1.0.0",
    "@stynx-nyx/feature-flags": "^0.1.0",
    "@stynx-nyx/health": "^1.0.0",
    "@stynx-nyx/integration-adapter": "^0.1.0",
    "@stynx-nyx/logging": "^1.0.0",
    "@stynx-nyx/pdf": "^0.1.0",
    "@stynx-nyx/pdf-a": "^0.1.0",
    "@stynx-nyx/pdf-a-vera-docker": "^0.1.0",
    "@stynx-nyx/signature": "^0.1.0",
    "@types/node-forge": "^1.3.14",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "fast-check": "^3.23.2",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.6.1",
    "node-forge": "^1.4.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
