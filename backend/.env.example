PORT=3000
# Required when NODE_ENV=production. Comma-separate the admin and portal
# origins when both are deployed.
CORS_ORIGIN=http://localhost:4200
DATABASE_URL=postgresql://sgp:sgp@localhost:5432/sgp
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=example-client-id
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example
AWS_REGION=us-east-1
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_DOCUMENTS_BUCKET=sgp-documents-stage
S3_DOCUMENTS_PRESIGN_EXPIRES_SECONDS=900
S3_DOCUMENTS_DOWNLOAD_EXPIRES_SECONDS=300
S3_DOCUMENTS_KEY_PREFIX=documents
SGP_RATE_LIMIT_IP_LIMIT=120
SGP_RATE_LIMIT_IP_TTL_MS=60000
SGP_RATE_LIMIT_TENANT_LIMIT=600
SGP_RATE_LIMIT_TENANT_TTL_MS=60000
SGP_RATE_LIMIT_TRUST_PROXY=false
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=sgp-core-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=sgp
OTEL_SDK_DISABLED=false
MINIO_TEST_STORAGE_ENABLED=false
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_DOCUMENTS_BUCKET=sgp-test-documents
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
SGP_PII_PGCRYPTO_KEY=replace-with-runtime-secret
SGP_PII_PGCRYPTO_KEY_ID=local-dev-key
ESOCIAL_ENV=QUALIFICATION
ESOCIAL_ENDPOINT_ENVIO=https://webservices.producaorestrita.esocial.gov.br/servicos/empregador/enviarloteeventos/WsEnviarLoteEventos.svc
ESOCIAL_ENDPOINT_CONSULTA=https://webservices.producaorestrita.esocial.gov.br/servicos/empregador/consultarloteeventos/WsConsultarLoteEventos.svc
