{
  "schemaVersion": "1.0.0",
  "project_type": "runtime-host",
  "name": "sgp",
  "version": "0.0.1",
  "sourceRoot": ".",
  "package_manager": "npm",
  "commands": {
    "build": "npm run build",
    "lint": "npm run lint:check",
    "format": "npm run format:check",
    "typecheck": "npm run typecheck",
    "test": "npm run test",
    "test_backend": "npm run test:backend -- --runInBand",
    "test_db": "DATABASE_URL=postgresql://$USER@localhost:5432/sgp_test npm run test:db",
    "test_e2e": "npm run test:e2e -- --runInBand",
    "test_coverage": "npm run test:coverage",
    "test_frontend_coverage": "npm run test:frontend:coverage",
    "governance": "npm run governance:check",
    "health": "npm run health:json"
  },
  "hardFailGates": [
    {
      "id": "lint-check",
      "command": "npm run lint:check"
    },
    {
      "id": "format-check",
      "command": "npm run format:check"
    },
    {
      "id": "typecheck",
      "command": "npm run typecheck"
    },
    {
      "id": "type-contracts",
      "command": "npm run test:types"
    },
    {
      "id": "mutation",
      "command": "npm run test:mutation"
    },
    {
      "id": "duplication",
      "command": "npm run check:duplication"
    },
    {
      "id": "api-alignment",
      "command": "npm run api:alignment:check -- --json"
    },
    {
      "id": "db-alignment",
      "command": "npm run db:alignment:check -- --json"
    },
    {
      "id": "health-json",
      "command": "npm run health:json"
    },
    {
      "id": "governance-check",
      "command": "npm run governance:check"
    }
  ]
}
